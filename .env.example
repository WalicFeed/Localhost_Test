# PostgreSQL (локально или Docker: см. docker-compose)
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# Один и тот же секрет для Fastify (@fastify/jwt) и Next.js middleware (jose)
JWT_SECRET="замените_на_случайную_строку_минимум_32_символа"

# URL Fastify для прокси Next.js (rewrite /api → API)
FASTIFY_INTERNAL_URL="http://127.0.0.1:4000"
